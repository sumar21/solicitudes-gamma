{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-enrich-beds",
      "schedule": "0,15,30,45 * * * *"
    },
    {
      "path": "/api/cron-cleanup-notifs",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron-trigger-testing",
      "schedule": "5,20,35,50 * * * *"
    }
  ],
  "functions": {
    "api/cron-diet-changes.ts": { "maxDuration": 300 },
    "api/cron-enrich-beds.ts": { "maxDuration": 300 },
    "api/cron-cleanup-notifs.ts": { "maxDuration": 300 },
    "api/cron-trigger-testing.ts": { "maxDuration": 15 },
    "api/tickets.ts": { "maxDuration": 60 },
    "api/limpiezas.ts": { "maxDuration": 30 }
  }
}
