# Grupo Gamma API credentials — set these in Vercel environment variables.
# Never commit real values here.

# VM proxy URL (defaults to http://35.224.5.114/proxy/index.php if not set)
# GAMMA_VM_URL=http://35.224.5.114/proxy/index.php

# Microsoft Graph / SharePoint (Azure AD App Registration)
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENTE_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
SHAREPOINT_SITE_ID=your_site_id_here
# ENTORNO — separa datos de producción y testing dentro de las MISMAS listas SP.
# `07.Traslados` (campo Entorno_T) y `08.Aislamientos` (campo Entorno_A) filtran por
# este valor en lectura y lo escriben en cada POST. Default seguro: TESTING.
# Valores válidos: PRODUCTIVO | TESTING
ENTORNO=TESTING

# JWT — usá un string aleatorio largo (ej: openssl rand -base64 32)
JWT_SECRET=your_long_random_secret_here
# List IDs are hardcoded in each api/*.ts file (structural constants, not secrets)

# Upstash Redis — rate limiting del login (anti brute-force).
# Si están seteadas, el rate limit se persiste en Redis (compartido entre instancias Vercel
# y sobrevive cold-starts). Si no están, fallback a contador in-memory por instancia.
# Setup:
#   1. Crear cuenta gratis en https://upstash.com → Create Database (Global, plan Free).
#   2. En el dashboard de la DB, copiar "REST URL" y "REST Token" (sección "REST API").
#   3. Pegar los valores acá y replicarlos en Vercel: Settings → Environment Variables.
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AYxxxxx...

# Cron job de cambios de dieta (GitHub Actions cada 30 min llama /api/cron-diet-changes).
# CRON_SECRET autoriza al workflow (debe matchear el secret cargado en GitHub).
# Generar con PowerShell:
#   $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
CRON_SECRET=tu_secret_aleatorio_largo

# ══════════════ SUPABASE (migración de traslados — ver docs/traslados-migracion-supabase.md) ══════════════
# CLIENTE (Vite las mete en el bundle → son PÚBLICAS). Necesarias para el Realtime del mapa.
VITE_SUPABASE_URL=https://<project_ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # publishable key (pública; la protege el RLS)

# SERVIDOR (Edge Functions / escrituras desde el backend). 🔴 SECRETA — nunca al cliente.
# SUPABASE_SECRET_KEY=sb_secret_...

# El "JWT secret" del proyecto Supabase — con esto /api/supabase-token firma el "pase" de lectura
# (HS256) que las policies de RLS leen. Dashboard → Settings → API → JWT Settings → "JWT Secret".
# 🔴 SECRETA — server-side. Sin esto, /api/supabase-token devuelve 503.
SUPABASE_JWT_SECRET=el_jwt_secret_del_proyecto

# Solo si se usa el CLI para migraciones (opcional; también desde el SQL Editor / MCP). 🔴 tiene la password.
# SUPABASE_DB_URL=postgresql://postgres:<db_password>@db.<project_ref>.supabase.co:5432/postgres
